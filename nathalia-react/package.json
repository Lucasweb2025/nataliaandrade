{
  "name": "nathalia-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "vite build && node -e \"const fs=require('fs');const p=require('path');const src='dist';const dest='..';for(const f of fs.readdirSync(src)){const s=p.join(src,f);const d=p.join(dest,f);if(fs.statSync(s).isDirectory()){try{fs.rmSync(d,{recursive:true})}catch(e){}}fs.cpSync(s,d,{recursive:true})}\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@posthog/react": "^1.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "framer-motion": "^12.40.0",
    "posthog-js": "^1.407.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  }
